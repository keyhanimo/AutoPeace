    "openai": "^6.33.0",
    "pino": "^9",
    "pino-http": "^10",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
